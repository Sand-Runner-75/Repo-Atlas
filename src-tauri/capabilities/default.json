{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: open links in the browser, set the window title and theme, show notifications, start with Windows",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "opener:default",
    "notification:default",
    "autostart:default"
  ]
}
